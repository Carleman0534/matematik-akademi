# Bu dosyayı .env.local adıyla kopyalayıp değerleri Supabase projenizden doldurun (README → Kurulum).
# .env.local git'e eklenmez.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# YALNIZCA SUNUCUDA kullanılır (öğrenci hesabı açmak için). Asla paylaşmayın, NEXT_PUBLIC_ ile başlatmayın.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# İsteğe bağlı: öğrenci kullanıcı adlarının çevrildiği iç e-posta alanı (e-posta gönderilmez)
# STUDENT_EMAIL_DOMAIN=ogrenci.matematikakademi.app

# Harici Yapay Zekâ Denetleyici & Soru Çözüm Motoru (Google Gemini & OpenAI ChatGPT)
# Gemini için Google AI Studio'dan alınan anahtar (Örn: AIzaSy...)
GEMINI_API_KEY=
# ChatGPT için OpenAI API platformundan alınan anahtar (Örn: sk-proj-...)
OPENAI_API_KEY=
